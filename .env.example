NODE_ENV=development
PORT=2155
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# MongoDB local or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/heros_sos

# Generate independent random values, at least 32 bytes each
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_HASH_SECRET=replace_with_another_long_random_secret
OTP_TTL_MINUTES=5

# Demo-only credentials owner@heros.vn and contact@heros.vn. Disable outside demo environments.
DEMO_AUTH_ENABLED=true

# Leave SMTP_HOST empty to log OTP locally when EMAIL_DEV_LOG_OTP=true.
# For Resend: host=smtp.resend.com, port=587, user=resend, pass=API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Heros SOS <no-reply@your-verified-domain.com>

# Local-only fallback. Never enable this in production.
EMAIL_DEV_LOG_OTP=true

# Comma-separated OAuth client IDs accepted as Google ID-token audiences.
# Swift should request an ID token for the backend/web client ID.
GOOGLE_CLIENT_IDS=

# Firebase Admin service-account fields. Keep the escaped \n characters.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Private local storage for protected SOS voice clips. Use persistent storage.
SOS_RECORDINGS_DIR=private_uploads/sos-recordings
